APP_NAME="RC 101"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# Admin Authentication
ADMIN_EMAIL=admin@your-domain.com
ADMIN_ACCESS_CODE=ChangeMeToAStrongPassword2026!

# Primary Live Audio Stream
STREAM_URL=https://streams.radiomast.io/your-station-mount
steamUrl=https://streams.radiomast.io/your-station-mount

# Station Slogan (Tagline shown across player, media session, and title bar)
STATION_SLOGAN="Today's Best Country"

# Station Format / Music Genre
# Options: country | pop | rock | punk | jazz | hip-hop | rnb | metal | electronic | blues | folk | classical | latin | reggae | gospel
# Instantly switches all headlines, concert discovery, and content without code changes.
STATION_FORMAT=country

# API Keys & Endpoints
# Ticketmaster API (Get free key from developer.ticketmaster.com)
TICKETMASTER_Api_key=
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2

# News API (Get free key from newsapi.org)
NEWS_API_KEY=
NEWS_BASE_URL=https://newsapi.org/v2/everything
NewsService_BASE_URL=https://newsapi.org/v2

# Default Media & Assets (Relative to public/)
DEFAULT_ARTWORK_PATH=images/alexaicon.jpg
SOCIAL_SHARE_IMAGE=images/social-banner.png
SLOGAN_FILE_PATH=config/slogan.txt

# Song Request iFrame (Optional)
IFRAME_URL=
