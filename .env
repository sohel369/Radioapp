# ==============================================================================
# LOCAL / DEVELOPMENT CONFIGURATION (.env)
# ==============================================================================
# Radio Station Platform - Local Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & SECURITY
# ------------------------------------------------------------------------------
APP_NAME="RC 101"
APP_ENV=production
APP_KEY=base64:
APP_DEBUG=false
APP_URL=https://rc101country.com

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=
ADMIN_ACCESS_CODE=

# ------------------------------------------------------------------------------
# 2. AUDIO STREAM & PRIMARY STATION IDENTITY
# ------------------------------------------------------------------------------
STREAM_URL="https://streams.radiomast.io/rc101"
steamUrl="https://streams.radiomast.io/rc101"
BACKUP_STREAM_URL=
STREAM_MOUNT_POINT="/live"
AUTOPLAY_ENABLED=false

STATION_SLOGAN="Your Rockin' Country"
STATION_FORMAT="country"

STATION_FREQUENCY="101"
STATION_PHONE=""
STATION_EMAIL=""
STATION_ADDRESS=""

DEFAULT_ARTWORK_PATH=images/alexaicon.jpg
SLOGAN_FILE_PATH=config/slogan.txt
SOCIAL_SHARE_IMAGE=images/social-banner.png
IFRAME_URL=https://rc101country.com/requests/request.php

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 4. EXTERNAL APIS - CONCERTS, LOCATION & MUSIC NEWS
# ------------------------------------------------------------------------------
TICKETMASTER_API_KEY=
TICKETMASTER_Api_key=
TICKETMASTER_BASE_URL="https://app.ticketmaster.com/discovery/v2"
TICKETMASTER_DEFAULT_LOCATION="Nashville, TN"
TICKETMASTER_RADIUS=50

EVENTBRITE_API_KEY=
EVENTBRITE_BASE_URL="https://www.eventbriteapi.com/v3"

RAPIDAPI_KEY=

NEWS_API_KEY=
NEWS_API_BASE_URL="https://newsapi.org/v2/"
NEWS_BASE_URL="https://newsapi.org/v2/everything"
NewsService_BASE_URL="https://newsapi.org/v2"
NEWS_GENRE="country"
NEWS_SEARCH_QUERY='("country music" OR "Grand Ole Opry" OR "CMA" OR "Nashville") AND US'
NEWS_ITEMS_LIMIT=8
NEWS_COUNTRY="us"
DEFAULT_NEWS_SOURCE="RC 101 Country News"

IP_API_URL=http://ip-api.com/json
IPINFO_URL=https://ipinfo.io
FREEGEOIP_URL=https://freegeoip.app/json

# ------------------------------------------------------------------------------
# 5. CACHE, SESSIONS, QUEUES & REDIS
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 6. AWS / CLOUD STORAGE
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 7. LOGGING & ERROR MONITORING
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 8. EMAIL CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
#MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 9. SOCIAL MEDIA & EXTERNAL LINKS
# ------------------------------------------------------------------------------
FACEBOOK_URL=""
INSTAGRAM_URL="https://instagram.com/rc101country"
TWITTER_URL=""
YOUTUBE_URL=""
APP_STORE_URL=""
PLAY_STORE_URL=""
FB_APP_ID=

# ------------------------------------------------------------------------------
# 10. SEO & INDEXING DEFAULTS
# ------------------------------------------------------------------------------
SEO_TITLE="RC 101  |  Your Rockin' Country"
SEO_DESCRIPTION="Listen live to RC 101 for today's top country hits- commercial free, signed artist tour dates, breaking country music news, and exclusive studio contests."
SEO_KEYWORDS="country radio, country music stream, country concerts, Nashville news, live audio stream"
ROBOTS_INDEXING="index, follow"