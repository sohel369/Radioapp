# ==============================================================================
# PRODUCTION STATION CONFIGURATION TEMPLATE (.env.production)
# ==============================================================================
# Radio Station Platform - Live Server Environment Configuration
# Copy this file to .env on your live production server:
# cp .env.production .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & SECURITY
# ------------------------------------------------------------------------------
APP_NAME="RC 101"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourstationdomain.com

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL="admin@yourstationdomain.com"
ADMIN_ACCESS_CODE="ChangeThisStrongSecretCode2026"

# ------------------------------------------------------------------------------
# 2. AUDIO STREAM & PRIMARY STATION IDENTITY
# ------------------------------------------------------------------------------
# Primary Icecast / Shoutcast / RadioMast streaming mount point (MUST USE HTTPS)
STREAM_URL="https://streams.radiomast.io/rc101"
steamUrl="https://streams.radiomast.io/rc101"
BACKUP_STREAM_URL=
STREAM_MOUNT_POINT="/live"
AUTOPLAY_ENABLED=false

# Station Tagline / Slogan
STATION_SLOGAN="Today's Best Country"

# Station Primary Music Format / Genre
# Options: country | pop | rock | punk | jazz | hip-hop | rnb | metal | electronic | blues | folk | classical | latin | reggae | gospel
STATION_FORMAT="country"

# Station Frequency and Contact Info
STATION_FREQUENCY="101.1 FM"
STATION_PHONE="(555) 123-4567"
STATION_EMAIL="studio@yourstationdomain.com"
STATION_ADDRESS="100 Radio Drive, Suite 200, Nashville, TN 37203"

DEFAULT_ARTWORK_PATH="images/alexaicon.jpg"
SLOGAN_FILE_PATH="config/slogan.txt"
SOCIAL_SHARE_IMAGE="images/social-banner.png"
IFRAME_URL="https://rc101.us/requests/request.php"

# ------------------------------------------------------------------------------
# 3. LIVE DATABASE CONFIGURATION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_live_db_name
DB_USERNAME=your_live_db_user
DB_PASSWORD="your_strong_db_password"

# ------------------------------------------------------------------------------
# 4. EXTERNAL APIS - CONCERTS, LOCATION & MUSIC NEWS
# ------------------------------------------------------------------------------
# Ticketmaster Discovery API (Free registration at https://developer.ticketmaster.com)
TICKETMASTER_API_KEY="your_ticketmaster_api_key_here"
TICKETMASTER_Api_key="your_ticketmaster_api_key_here"
TICKETMASTER_BASE_URL="https://app.ticketmaster.com/discovery/v2"
TICKETMASTER_DEFAULT_LOCATION="Nashville, TN"
TICKETMASTER_RADIUS=50

# Eventbrite API (https://www.eventbrite.com/platform/api)
EVENTBRITE_API_KEY=
EVENTBRITE_BASE_URL="https://www.eventbriteapi.com/v3"

RAPIDAPI_KEY=

# News API Configuration (https://newsapi.org or fallback Google News RSS)
NEWS_API_KEY="your_news_api_key_here"
NEWS_API_BASE_URL="https://newsapi.org/v2/"
NEWS_BASE_URL="https://newsapi.org/v2/everything"
NewsService_BASE_URL="https://newsapi.org/v2"
NEWS_GENRE="country"
NEWS_SEARCH_QUERY='("country music" OR "Grand Ole Opry" OR "CMA" OR "Nashville") AND US'
NEWS_ITEMS_LIMIT=8
NEWS_COUNTRY="us"
DEFAULT_NEWS_SOURCE="RC 101 Country News"

# Location Services APIs
IP_API_URL=http://ip-api.com/json
IPINFO_URL=https://ipinfo.io
FREEGEOIP_URL=https://freegeoip.app/json

# ------------------------------------------------------------------------------
# 5. CACHE, SESSIONS, QUEUES & REDIS
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=radio_cache_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 6. AWS / CLOUD STORAGE
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 7. LOGGING & ERROR MONITORING
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# 8. EMAIL CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourstationdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 9. SOCIAL MEDIA & EXTERNAL LINKS
# ------------------------------------------------------------------------------
FACEBOOK_URL="https://facebook.com/yourstation"
INSTAGRAM_URL="https://instagram.com/yourstation"
TWITTER_URL="https://twitter.com/yourstation"
YOUTUBE_URL="https://youtube.com/@yourstation"
APP_STORE_URL="https://apps.apple.com"
PLAY_STORE_URL="https://play.google.com"
FB_APP_ID=

# ------------------------------------------------------------------------------
# 10. SEO & INDEXING DEFAULTS
# ------------------------------------------------------------------------------
SEO_TITLE="RC 101 - Today's Best Country | Live Streaming & Tour Dates"
SEO_DESCRIPTION="Listen live to RC 101 for today's top country hits, signed artist tour dates, breaking country music news, and exclusive studio contests."
SEO_KEYWORDS="country radio, country music stream, country concerts, Nashville news, live audio stream"
ROBOTS_INDEXING="index, follow"
